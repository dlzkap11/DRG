.screen {
    flex-grow: 1;
    padding: 16px;
    background-color: rgb(24, 26, 32);
    color: rgb(226, 228, 234);
}

.header {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 12px;
}

.title {
    font-size: 28px;
    -unity-font-style: bold;
    margin-right: 16px;
}

.phase {
    font-size: 16px;
    color: rgb(160, 168, 184);
}

.player-list {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.game-root {
    flex-grow: 1;
}

/* Lobby and Result screens: one centered panel. */
.center-panel {
    align-self: center;
    align-items: center;
    min-width: 560px;
    margin-top: 60px;
    padding: 24px;
}

.center-panel .title {
    margin-right: 0;
    margin-bottom: 8px;
}

.center-panel .button-row {
    justify-content: center;
    margin-top: 8px;
    margin-bottom: 8px;
}

.participant-list,
.ranking-list {
    align-self: stretch;
    margin-bottom: 8px;
}

.participant-row,
.ranking-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 6px 10px;
    margin-bottom: 4px;
    border-radius: 4px;
    background-color: rgb(38, 42, 52);
}

.ranking-row.is-human {
    border-width: 2px;
    border-color: rgb(90, 160, 255);
}

.participant-name,
.ranking-name {
    font-size: 15px;
    flex-grow: 1;
}

.participant-ready {
    font-size: 14px;
    color: rgb(160, 168, 184);
}

.participant-ready.is-ready {
    color: rgb(120, 210, 140);
}

.ranking-rank {
    font-size: 15px;
    -unity-font-style: bold;
    min-width: 40px;
}

.ranking-standing {
    font-size: 14px;
    color: rgb(160, 168, 184);
}

/* Up to 8 compact cards share one row at the 1280x720 reference size. */
.player-card {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 120px;
    max-width: 220px;
    padding: 8px;
    margin-right: 8px;
    margin-bottom: 8px;
    border-radius: 6px;
    background-color: rgb(38, 42, 52);
    border-width: 2px;
    border-color: rgb(60, 66, 80);
}

.player-card.is-human {
    border-color: rgb(90, 160, 255);
}

.player-card.is-eliminated {
    opacity: 0.45;
}

.player-name {
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.player-stat,
.player-status,
.player-action {
    font-size: 13px;
}

.player-status {
    color: rgb(160, 168, 184);
}

.player-action {
    white-space: normal;
}

.main {
    flex-direction: row;
    flex-grow: 1;
}

.column {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 12px;
}

.panel {
    flex-shrink: 0;
    padding: 10px;
    margin-bottom: 10px;
    border-radius: 6px;
    background-color: rgb(32, 35, 44);
}

.panel-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(160, 168, 184);
    margin-bottom: 6px;
}

.button-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.action-button,
.target-button,
.lock-button {
    background-color: rgb(58, 64, 80);
    border-color: rgb(84, 92, 110);
    color: rgb(226, 228, 234);
}

.action-button:hover,
.target-button:hover,
.lock-button:hover {
    background-color: rgb(74, 82, 102);
}

.action-button:disabled,
.target-button:disabled,
.lock-button:disabled {
    opacity: 0.35;
}

.action-button,
.target-button {
    min-width: 140px;
    height: 40px;
    margin-right: 6px;
    margin-bottom: 6px;
    font-size: 14px;
}

.target-button {
    min-width: 96px;
}

.action-button.selected,
.target-button.selected {
    background-color: rgb(90, 160, 255);
    border-color: rgb(140, 190, 255);
    color: rgb(16, 18, 24);
}

.lock-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.selection-label {
    font-size: 15px;
}

.lock-button {
    min-width: 120px;
    height: 40px;
    margin-right: 6px;
    font-size: 16px;
    -unity-font-style: bold;
}

.result-label {
    font-size: 14px;
    white-space: normal;
    margin-bottom: 8px;
}

.game-over {
    align-items: center;
}

.log-panel {
    flex-grow: 1;
    flex-basis: 0;
    max-width: 420px;
}

.battle-log {
    flex-grow: 1;
}

.log-line {
    font-size: 13px;
    white-space: normal;
}
